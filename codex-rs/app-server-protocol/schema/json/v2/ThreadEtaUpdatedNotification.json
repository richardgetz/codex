{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadEtaAccuracy": {
      "description": "Accuracy classification against a task's immutable original estimate.",
      "enum": [
        "early",
        "within",
        "late",
        "unknown"
      ],
      "type": "string"
    },
    "ThreadEtaOverall": {
      "description": "Aggregate remaining work for the selected root session.",
      "properties": {
        "finishAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "remainingLowerSeconds": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "remainingUpperSeconds": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "unknownReason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ThreadEtaRevision": {
      "description": "One bounded estimate revision retained for a task.",
      "properties": {
        "actorThreadId": {
          "type": "string"
        },
        "lowerSeconds": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        },
        "upperSeconds": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "actorThreadId",
        "updatedAt"
      ],
      "type": "object"
    },
    "ThreadEtaStatus": {
      "description": "Lifecycle state for a task tracked by the ETA store.",
      "enum": [
        "pending",
        "active",
        "blocked",
        "completed",
        "cancelled",
        "unknown"
      ],
      "type": "string"
    },
    "ThreadEtaTask": {
      "description": "A task in the root session's active tree or bounded history page.",
      "properties": {
        "accuracy": {
          "$ref": "#/definitions/ThreadEtaAccuracy"
        },
        "actualElapsedSeconds": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "currentLowerSeconds": {
          "description": "Remaining duration range for active work; terminal rows retain their last range.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "currentUpperSeconds": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "dependsOnTaskIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "isStale": {
          "type": "boolean"
        },
        "originalLowerSeconds": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "originalUpperSeconds": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "ownerThreadId": {
          "type": "string"
        },
        "parentTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "revisions": {
          "items": {
            "$ref": "#/definitions/ThreadEtaRevision"
          },
          "type": "array"
        },
        "rootThreadId": {
          "type": "string"
        },
        "startedAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/ThreadEtaStatus"
        },
        "taskId": {
          "type": "string"
        },
        "terminalAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "accuracy",
        "createdAt",
        "dependsOnTaskIds",
        "isStale",
        "ownerThreadId",
        "revisions",
        "rootThreadId",
        "status",
        "taskId",
        "title",
        "updatedAt"
      ],
      "type": "object"
    }
  },
  "description": "Event-driven update emitted after a task mutation. Clients should refresh the read projection only when this sequence is newer than their local snapshot.",
  "properties": {
    "changedTasks": {
      "items": {
        "$ref": "#/definitions/ThreadEtaTask"
      },
      "type": "array"
    },
    "generatedAt": {
      "format": "int64",
      "type": "integer"
    },
    "overall": {
      "$ref": "#/definitions/ThreadEtaOverall"
    },
    "rootThreadId": {
      "type": "string"
    },
    "sequence": {
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "changedTasks",
    "generatedAt",
    "overall",
    "rootThreadId",
    "sequence"
  ],
  "title": "ThreadEtaUpdatedNotification",
  "type": "object"
}