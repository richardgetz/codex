{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "SlashCommandOutput": {
      "properties": {
        "format": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "format",
        "text"
      ],
      "type": "object"
    },
    "SlashCommandReloadResult": {
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "eligible",
        "state"
      ],
      "type": "object"
    },
    "SlashCommandResultKind": {
      "enum": [
        "status",
        "spend",
        "reload",
        "text",
        "error"
      ],
      "type": "string"
    },
    "SlashCommandResultPayload": {
      "description": "Payload carried by the asynchronous slash-command result notification.\n\nThis intentionally has its own schema name instead of reusing [`SlashCommandExecuteResponse`].  The app-server schema exporter emits response types and notification payloads as independent roots; nesting the response root in the notification causes a duplicate v2 definition.",
      "properties": {
        "command": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "output": {
          "$ref": "#/definitions/SlashCommandOutput"
        },
        "reload": {
          "anyOf": [
            {
              "$ref": "#/definitions/SlashCommandReloadResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "resultKind": {
          "$ref": "#/definitions/SlashCommandResultKind"
        }
      },
      "required": [
        "command",
        "ok",
        "output",
        "resultKind"
      ],
      "type": "object"
    }
  },
  "description": "Non-model output generated by a slash command.",
  "properties": {
    "command": {
      "type": "string"
    },
    "requestId": {
      "type": "string"
    },
    "result": {
      "$ref": "#/definitions/SlashCommandResultPayload"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "command",
    "requestId",
    "result",
    "threadId"
  ],
  "title": "SlashCommandResultNotification",
  "type": "object"
}