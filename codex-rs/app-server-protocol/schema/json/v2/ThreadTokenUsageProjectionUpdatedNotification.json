{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadTokenUsageAttribution": {
      "description": "Source metadata captured with one exact upstream response.",
      "properties": {
        "contextLength": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelProvider": {
          "type": [
            "string",
            "null"
          ]
        },
        "serviceTier": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ThreadTokenUsageProjection": {
      "properties": {
        "threads": {
          "items": {
            "$ref": "#/definitions/ThreadTokenUsageProjectionThread"
          },
          "type": "array"
        },
        "total": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        }
      },
      "required": [
        "threads",
        "total"
      ],
      "type": "object"
    },
    "ThreadTokenUsageProjectionThread": {
      "properties": {
        "forkedFromId": {
          "type": [
            "string",
            "null"
          ]
        },
        "parentThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "responseIds": {
          "items": {
            "$ref": "#/definitions/ThreadTokenUsageResponseIdentity"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/definitions/ThreadTokenUsageSource"
          },
          "type": "array"
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "responseIds",
        "sources",
        "threadId"
      ],
      "type": "object"
    },
    "ThreadTokenUsageResponseIdentity": {
      "properties": {
        "responseId": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "responseId",
        "threadId"
      ],
      "type": "object"
    },
    "ThreadTokenUsageSource": {
      "description": "Cumulative exact usage for one model/provider/service-tier/context source. This is sent only as part of restored thread usage so clients can price mixed-model histories without replaying every response record.",
      "properties": {
        "attribution": {
          "$ref": "#/definitions/ThreadTokenUsageAttribution"
        },
        "responseIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "threadId": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        }
      },
      "required": [
        "attribution",
        "responseIds",
        "threadId",
        "usage"
      ],
      "type": "object"
    },
    "TokenUsageBreakdown": {
      "properties": {
        "cacheWriteInputTokens": {
          "default": 0,
          "format": "int64",
          "type": "integer"
        },
        "cachedInputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "inputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "outputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "reasoningOutputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "totalTokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "inputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "type": "object"
    }
  },
  "description": "Complete billing usage reconstructed from persisted response records.\n\nThis notification is sent independently from the context-window counters in [`ThreadTokenUsageUpdatedNotification`]. A missing projection means the server could not read the complete history; an empty projection is a complete zero-usage baseline.",
  "properties": {
    "threadId": {
      "type": "string"
    },
    "usageProjection": {
      "anyOf": [
        {
          "$ref": "#/definitions/ThreadTokenUsageProjection"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "threadId"
  ],
  "title": "ThreadTokenUsageProjectionUpdatedNotification",
  "type": "object"
}