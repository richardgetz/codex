+    async fn inline_visual_assets(&mut self) {
+        const MAX_VISUAL_IMAGE_CANDIDATES: usize = 96;
+        const MAX_VISUAL_IMAGE_BYTES: usize = 512 * 1024;
+        const MAX_VISUAL_IMAGE_TOTAL_BYTES: usize = 8 * 1024 * 1024;
+
+        let Some(image_sources_json) = self.js.as_mut().and_then(|js| {
+            let script = format!(
+                r#"
+                    JSON.stringify(Array.from(document.querySelectorAll("img[src]") || [])
+                        .map((img, index) => ({{index, src: img.getAttribute("src") || ""}}))
+                        .filter((entry) => entry.src && !entry.src.startsWith("data:") && !entry.src.startsWith("blob:"))
+                        .slice(0, {MAX_VISUAL_IMAGE_CANDIDATES}))
+                "#
+            );
+            js.evaluate(
+                &script,
+            ).ok().and_then(|value| value.as_str().map(ToString::to_string))
+        }) else {
+            return;
+        };
+        let Ok(image_sources) = serde_json::from_str::<serde_json::Value>(&image_sources_json) else {
+            return;
+        };
+        let Some(image_sources) = image_sources.as_array() else {
+            return;
+        };
+
+        let mut updates = Vec::new();
+        let mut total_bytes = 0;
+        for image in image_sources {
+            let Some(index) = image.get("index").and_then(serde_json::Value::as_u64) else {
+                continue;
+            };
+            let Some(src) = image.get("src").and_then(serde_json::Value::as_str) else {
+                continue;
+            };
+            let asset_url = if src.starts_with("http://") || src.starts_with("https://") || src.starts_with("file://") {
+                Url::parse(src).ok()
+            } else {
+                self.url.as_ref().and_then(|base| base.join(src).ok())
+            };
+            let Some(asset_url) = asset_url else {
+                continue;
+            };
+            if self.should_block_url(asset_url.as_str()) {
+                continue;
+            }
+            let Ok(response) = self.do_fetch(&asset_url).await else {
+                continue;
+            };
+            if response.body.is_empty() || response.body.len() > MAX_VISUAL_IMAGE_BYTES {
+                continue;
+            }
+            if total_bytes + response.body.len() > MAX_VISUAL_IMAGE_TOTAL_BYTES {
+                break;
+            }
+            total_bytes += response.body.len();
+            self.record_network_event(&asset_url.to_string(), "GET", "Image", response.status, &response.headers, response.body.len());
+            let mime = response
+                .headers
+                .get("content-type")
+                .and_then(|value| value.split(';').next())
+                .map(str::trim)
+                .filter(|value| !value.is_empty())
+                .unwrap_or_else(|| mime_from_image_url(asset_url.as_str()));
+            let data_url = format!("data:{mime};base64,{}", BASE64.encode(&response.body));
+            updates.push(serde_json::json!({
+                "index": index,
+                "original": src,
+                "dataUrl": data_url,
+            }));
+        }
+
+        if updates.is_empty() {
+            return;
+        }
+        if let Some(js) = &mut self.js {
+            let updates_json = serde_json::to_string(&updates).unwrap_or_else(|_| "[]".to_string());
+            let script = format!(
+                r#"(function(updates) {{
+                    var images = Array.from(document.querySelectorAll("img[src]") || []);
+                    for (var i = 0; i < updates.length; i++) {{
+                        var update = updates[i];
+                        var img = images[update.index];
+                        if (!img || img.getAttribute("src") !== update.original) continue;
+                        img.setAttribute("data-obscura-original-src", update.original);
+                        img.setAttribute("src", update.dataUrl);
+                    }}
+                }})({updates_json});"#
+            );
+            let _ = js.execute_script("<visual-assets>", &script);
+        }
+    }
