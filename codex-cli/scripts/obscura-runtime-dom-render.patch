+    #[test]
+    fn test_insert_before_preserves_parent_order() {
+        let mut rt = setup_runtime(r#"<div id="root"><span id="b">B</span></div>"#);
+        rt.execute_script("test", r#"
+            var root = document.getElementById('root');
+            var b = document.getElementById('b');
+            var a = document.createElement('span');
+            a.id = 'a';
+            a.textContent = 'A';
+            root.insertBefore(a, b);
+        "#).unwrap();
+
+        let text = rt.evaluate("document.getElementById('root').textContent").unwrap();
+        assert_eq!(text, serde_json::json!("AB"));
+        let first_id = rt.evaluate("document.getElementById('root').firstChild.id").unwrap();
+        assert_eq!(first_id, serde_json::json!("a"));
+    }
+
+    #[test]
+    fn test_text_node_data_updates_backing_dom() {
